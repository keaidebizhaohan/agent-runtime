# versatile_proxy.yaml — VersatileAdapterRunner 动态路由配置示例
#
# 部署路径（默认）：/etc/edpagent/config/versatile_proxy.yaml
# 若该文件不存在，Runner 会自动从 Settings（.env / 环境变量）生成唯一的 controller 配置。
#
# 配置文件加载优先级：
#   1. VersatileAdapterRunner(config_path=...) 显式参数
#   2. 环境变量 VERSATILE_PROXY_CONFIG_PATH
#   3. 部署默认路径 /etc/edpagent/config/versatile_proxy.yaml
#   4. 当前 versatile_adapter 目录下的 versatile_proxy.yaml（便于本地开发）
#
# workflow_defaults 仅对 type: workflow 的 adapter 生效：
#   - workflow adapter 未配置的字段会从 workflow_defaults 继承
#   - workflow adapter 显式配置优先于 workflow_defaults
#   - headers_template 会浅合并，adapter 同名 header 覆盖默认值
#   - forward_header_whitelist 不合并；adapter 配置后整体覆盖默认白名单
#   - controller 通常只有一个，请在 controller adapter 内完整配置
#
# adapters 列表可包含多个 adapter，运行时按 target 动态匹配：
#   - target 含 workflow_id / intent 且匹配到 workflow 配置 → VersatileWorkflow
#   - 否则 → VersatileController（使用第一个 type=controller 的配置）
#
# 各字段说明：
#   name                     — 适配器名称（日志标识）
#   type                     — controller（一级控制器）或 workflow（低码工作流）
#   url_template             — URL 模板，支持占位符 {conversation_id}、{workflow_id}
#   timeout                  — HTTP 流式请求超时（秒），默认 600
#   headers_template         — 调用 Versatile 时注入的默认请求头
#   forward_header_whitelist — 仅转发白名单中的外部请求头（小写）；不设置则转发全部
#   workflow_result_node     — （controller/workflow 可选）SSE 流中匹配 node_type=="QA" 且
#                              node_name==此值的帧，提取 text 作为 workflow_result；
#                              adapter 级配置，每个 adapter 可不同
#   workflow_id              — （仅 workflow）target 中 workflow_id 精确匹配时命中
#   intent                   — （仅 workflow）target 中 intent 匹配时命中

workflow_defaults:
  url_template: "https://versatile.example.com/workflows/{workflow_id}/conversations/{conversation_id}"
  timeout: 600
  headers_template:
    Accept: "application/json, text/event-stream"
    stream: "true"
  forward_header_whitelist:
    - x-user-id
    - x-project-id
    - cust-token
    - cust-userid
    - cookie

adapters:
  - name: default_controller
    type: controller
    url_template: "https://versatile.example.com/api/conversations/{conversation_id}"
    timeout: 600
    headers_template:
      Accept: "application/json, text/event-stream"
      stream: "true"
    forward_header_whitelist:
      - x-user-id
      - x-project-id
      - cust-token
      - cust-userid
      - cookie
    workflow_result_node: ""

  - name: versatile_workflow_1
    type: workflow
    intent: "knowledge_qa"
    workflow_id: "wf_abc123"
    workflow_result_node: "WorkflowQAResponseNode"

  - name: versatile_workflow_2
    type: workflow
    intent: "special_flow"
    workflow_id: "wf_special"
    url_template: "https://special.example.com/workflows/{workflow_id}/conversations/{conversation_id}"
    timeout: 120
    headers_template:
      X-App-Code: "special"
    forward_header_whitelist:
      - authorization
      - x-tenant-id
    workflow_result_node: "SpecialQAResponseNode"
