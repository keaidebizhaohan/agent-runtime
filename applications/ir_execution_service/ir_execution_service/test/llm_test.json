        "response_template": "",
        "stream_output": true
      }
    },
    {
      "id": "llm_JtqFn",
      "version": "",
      "name": "大模型1",
      "description": "",
      "type": 3,
      "type_version": "1.0.0",
      "inputs": {
        "input": "${start_Ag0l2.query}"
      },
      "outputs": {
        "string_array": "${string_array}",
        "integer_array": "${integer_array}",
        "boolean_array": "${boolean_array}",
        "number_array": "${number_array}"
      },
      "branches": [],
      "configs": {
        "model": {
          "model_id": "106",
          "model_client_config": {
            "client_provider": "openai",
            "api_key": null,
            "api_base": "https://dashscope.aliyuncs.com/compatible-mode/v1",
            "timeout": 90,
            "model_name": "qwen-plus",
            "parameters": {
              "temperature": 0.2,
              "max_tokens": 4000,
              "top_p": 0.2
            }
          },
          "request_config": {
            "model_name": "qwen-plus",
            "temperature": 0.2,
            "top_p": 0.2,
            "stream": true
          }
        },
        "template_content": [
          {
            "role": "system",
            "content": "请根据描述，输出一个json对象：\n对象必须包含以下 5 个字段，每个字段是一个数组：\n1. string_array：字符串数组，至少包含3个水果名，如 [\"苹果\", \"香蕉\"]\n2. integer_array：整数数组，至少包含3个正整数\n3. boolean_array：布尔数组，包含3个值，只能是 true 或 false\n4. number_array：浮点数数组，至少包含3个浮点数"
          },
          {
            "role": "user",
            "content": "{{input}}"
          }
        ],
        "response_format_type": "json",
        "output_config": {
          "string_array": {
            "type": "array",
            "description": "",
            "items": {
              "type": "string"
            },
            "required": true
          },
          "integer_array": {
            "type": "array",
            "description": "",
            "items": {
              "type": "integer"
            },
            "required": true
          },
          "boolean_array": {
            "type": "array",
            "description": "",
            "items": {
              "type": "boolean"
            },
            "required": true
          },
          "number_array": {
            "type": "array",
            "description": "",
            "items": {
              "type": "number"
            },
            "required": true
          }
        },
        "enable_history": false
      }
    }
  ],
  "connections": [
    {
      "source": "start_Ag0l2",
      "branch_id": "",
