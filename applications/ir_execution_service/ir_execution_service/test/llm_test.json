      "type_version": "1.0.0",
      "inputs": {
        "query": "${query}"
      },
      "outputs": {},
      "branches": [],
      "configs": {}
    },
    {
      "id": "end_Ag0l2",
      "version": "",
      "name": "结束",
      "description": "",
      "type": 2,
      "type_version": "1.0.0",
      "inputs": {
        "result": "${llm_JtqFn}"
