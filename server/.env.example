# 数据库类型：支持mysql、sqlite
DB_TYPE=mysql

# 数据库主机地址
DB_HOST=localhost

# 数据库端口：MySQL 服务监听的端口号
DB_PORT=3306

# 数据库登录用户名
DB_USER=root

# 数据库登录密码
DB_PASSWORD=root

# 要连接的数据库名称
DB_NAME=jiuwen_runtime

# 低码agent 和 agent-runtime-server 运行所在的主机IP地址
IP=127.0.0.1

# 低码agent 的容器镜像地址
LOWCODE_IMAGE=swr.cn-north-4.myhuaweicloud.com/openjiuwen/studio-lowercode-agent-amd64:8.8.8

# 部署目录：存放部署过程中产生的所有文件
DEPLOY_DIR=/app/deploys

# 依赖包目录：存放运行低码agent需要安装的所有 .whl文件
DIST_DIR=/app/dist

# 服务监听主机：0.0.0.0 表示允许所有网络地址访问
HOST=0.0.0.0

# 服务启动端口号
PORT=8186

# 为 uv 命令全局添加额外参数
# 解决部分内网/受限环境中 uv pip install 出现的 SSL 证书校验失败、TLS 握手异常、镜像源连接失败等问题
# 如下只是一个例子，请根据自身情况修改
UV_EXTRA_ARGS="--native-tls  --allow-insecure-host mirrors.aliyun.com -i https://mirrors.aliyun.com/pypi/simple/pip"